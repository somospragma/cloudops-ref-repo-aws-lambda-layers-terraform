# Lambda Layers Sample - Configuration Example
# Copy this file to terraform.auto.tfvars and modify the values

# AWS Configuration
aws_region = "us-east-1"

# Tagging System
client      = "pragma"
project     = "genai-sample"
environment = "dev"
profile = "lab-chapter"

# Common tags applied to all resources
common_tags = {
  environment = "dev"
  project     = "genai-sample"
  client      = "pragma"
  owner       = "cloudops"
  area        = "infrastructure"
  provisioned = "terraform"
  datatype    = "operational"
}

# Lambda Layers Configuration
layers_config = {
  # Example 1: Layer from local ZIP file (built by external process)
  requests-layer = {
    type        = "zip"
    zip_path    = "layers/requests-layer.zip"
    zip_hash    = filebase64sha256("layers/requests-layer.zip")
    description = "Python requests library layer"
    runtime     = "python3.12"
    additional_tags = {
      purpose = "http-client"
      team    = "backend"
    }
  }
  
  # Example 2: Another local ZIP layer
  utils-layer = {
    type        = "zip"
    zip_path    = "layers/utils-layer.zip"
    zip_hash    = filebase64sha256("layers/utils-layer.zip")
    description = "Utilities layer"
    runtime     = "python3.12"
    additional_tags = {
      purpose = "utilities"
      team    = "shared"
    }
  }
  
  # Example 3: Layer from S3 (for CI/CD pipelines)
  prod-layer = {
    type             = "s3"
    s3_bucket        = "my-lambda-artifacts-bucket"
    s3_key           = "layers/prod-layer-v1.0.0.zip"
    source_code_hash = "sha256-abcdef123456..."
    description      = "Production layer from S3"
    runtime          = "python3.12"
    additional_tags = {
      purpose = "production"
      version = "1.0.0"
    }
  }
}